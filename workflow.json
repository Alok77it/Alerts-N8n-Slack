    {
      "parameters": {
        "jsCode": "// Extract results\nconst servers = items.map(item => {\n  const out = item.json.stdout || \"\";\n  const lines = out.split(\"\\n\").map(l => l.trim()).filter(l => l);\n\n  let hostname = \"-\";\n  let cpu = \"-\";\n  let ram = \"-\";\n  let disk = \"-\";\n  let daily = \"❌ None\";\n  let weekly = \"❌ None\";\n  let monthly = \"❌ None\";\n\n  lines.forEach(line => {\n    if (line.includes(\"Hostname:\")) hostname = line.replace(\"[INFO] Hostname:\", \"\").trim();\n    if (line.includes(\"CPU Usage:\")) cpu = line.replace(\"[INFO] CPU Usage:\", \"\").trim();\n    if (line.includes(\"RAM Usage:\")) ram = line.replace(\"[INFO] RAM Usage:\", \"\").trim();\n    if (line.includes(\"Disk Usage:\")) disk = line.replace(\"[INFO] Disk Usage:\", \"\").trim();\n\n    // Daily backup check\n    if (line.includes(\"Daily backup found\")) {\n      const b = line.split(\":\").pop().trim();\n      daily = `✅ ${b}`;\n    }\n    if (line.includes(\"Daily backup MISSING\")) {\n      daily = \"❌ None\";\n    }\n\n    // Weekly backup check\n    if (line.includes(\"Weekly backup found\")) {\n      const b = line.split(\":\").pop().trim();\n      weekly = `✅ ${b}`;\n    }\n    if (line.includes(\"Weekly backup MISSING\")) {\n      weekly = \"❌ None\";\n    }\n    if (line.includes(\"Latest available weekly backup:\")) {\n      const b = line.split(\":\").pop().trim();\n      if (weekly === \"❌ None\") weekly = `📦 ${b}`; // show what exists\n    }\n\n    // Monthly backup check\n    if (line.includes(\"Monthly backup found\")) {\n      const b = line.split(\":\").pop().trim();\n      monthly = `✅ ${b}`;\n    }\n    if (line.includes(\"Monthly backup MISSING\")) {\n      monthly = \"❌ None\";\n    }\n  });\n\n  return { hostname, cpu, ram, disk, daily, weekly, monthly };\n});\n\n// Build Slack Markdown Table\nlet table = \"*📊 Server Health & Backup Status*\\n\";\ntable += \"```\";\ntable += \"Hostname                  | CPU   | RAM   | Disk  |       Daily       |       Weekly       |     Monthly\\n\";\ntable += \"--------------------------|-------|-------|-------|-------------------|-------------------|-------------\\n\";\n\nservers.forEach(s => {\n  table += `${s.hostname.padEnd(26)}| ${s.cpu.padEnd(5)} | ${s.ram.padEnd(5)} | ${s.disk.padEnd(5)} | ${s.daily.padEnd(17)} | ${s.weekly.padEnd(17)} | ${s.monthly}\\n`;\n});\n\ntable += \"```\";\n\n// Return for Slack\nreturn [{\n  json: {\n    text: table\n  }\n}];\n"
      },
